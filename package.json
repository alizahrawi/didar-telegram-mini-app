{
  "name": "diiidar-telegram-mini-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Diiidar — a serverless Telegram Mini App for human-centered event networking",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply diiidar-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply diiidar-db --local",
    "security:check": "node scripts/security-check.mjs",
    "test": "node --test",
    "bot:setup": "node scripts/setup-telegram.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.4"
  },
  "devDependencies": {
    "wrangler": "^4.40.3"
  }
}
