{
  "name": "didar-telegram-mini-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "دیدار — serverless Telegram Mini App on Cloudflare Workers and D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply didar-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply didar-db --local",
    "test": "node --test",
    "bot:setup": "node scripts/setup-telegram.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "wrangler": "^4.40.3"
  }
}
